#!/bin/sh
# Runs a one-off aishiterud command with the image that is running, e.g.
#
#   aishiterud migrate version
#   aishiterud token issue --actor ID --label grader-bot --days 90
set -eu
ENV_FILE=${AISHITERU_ENV_FILE:-/etc/aishiteru/aishiteru.env}
img=$(docker inspect -f '{{.Config.Image}}' aishiteru 2>/dev/null) ||
  { echo "aishiterud: no container named aishiteru; deploy one with aishiteru-deploy first" >&2; exit 1; }
exec docker run --rm -i --network host --env-file "$ENV_FILE" "$img" "$@"
