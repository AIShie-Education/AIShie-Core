#!/bin/sh
# Deploys an image of AIshie Core to this server: the first start, an
# upgrade and a rollback alike. Run as root, by hand or by the Deploy workflow
# over SSH (docs/deploying.md):
#
#   aishie-deploy ghcr.io/aishie-education/aishie-core:0.2.0
#
# In order: back up the database, `migrate up` and `seed` with the new image,
# replace the container, and wait until /healthz reports the new version and
# commit. It stops at the first step that fails. Up to replacing the
# container, the version that was running goes on running. If the new version
# never reports healthy, the version before is started again.
#
# The paths below are the ones deploy/setup-server.sh creates. The variables
# that override them are for deploy/aishie-deploy_test.sh.
set -eu
# The lock, the log and the backups are root's alone.
umask 077

die() { echo "aishie-deploy: $*" >&2; exit 1; }

# setting VAR DEFAULT: the value of AISHIE_VAR, or DEFAULT when that is unset
# or empty.
setting() {
  eval "new=\${AISHIE_$1:-} old=\${AISHITERU_$1:-}"
  # Compatibility: before the rename to AIshie these variables were
  # AISHITERU_*. The old name is still taken, with a warning, while the new
  # one is unset.
  if [ -z "$new" ] && [ -n "$old" ]; then
    echo "aishie-deploy: AISHITERU_$1 is deprecated: set AISHIE_$1 instead" >&2
    new=$old
  fi
  printf '%s\n' "${new:-$2}"
}

# The name of this server's installation: of its configuration, data and
# backup directories, its database and its container.
NAME=${AISHIE_NAME:-}
if [ -z "$NAME" ]; then
  NAME=aishie
  # Compatibility: a server set up before the rename to AIshie goes on by its
  # old name, aishiteru, which its /etc/aishiteru shows (docs/deploying.md, A
  # server set up before the rename).
  [ -e /etc/aishie ] || [ ! -e /etc/aishiteru ] || NAME=aishiteru
fi
case $NAME in *[!a-z0-9_]*) die "not a name: $NAME" ;; esac

ENV_FILE=$(setting ENV_FILE "/etc/$NAME/$NAME.env")
DATA_DIR=$(setting DATA_DIR "/srv/$NAME/data")
BACKUP_DIR=$(setting BACKUP_DIR "/var/backups/$NAME")
LOG_FILE=$(setting LOG_FILE "/var/log/$NAME-deploy.log")
LOCK_FILE=$(setting LOCK_FILE "/run/$NAME-deploy.lock")
HEALTH_TRIES=$(setting HEALTH_TRIES 30)
REPO=ghcr.io/aishie-education/aishie-core
KEEP_BACKUPS=10

IMG=${1:-}
# The image comes from the command line, or from SSH_ORIGINAL_COMMAND when
# the Deploy workflow calls: this image's repository, by tag or by digest,
# and nothing that is not part of such a name.
case $IMG in
  "$REPO":* | "$REPO"@sha256:*) ;;
  *) echo "usage: aishie-deploy $REPO:TAG (or @sha256:DIGEST)" >&2; exit 2 ;;
esac
case $IMG in *[!A-Za-z0-9._:@/-]*) echo "aishie-deploy: not an image name: $IMG" >&2; exit 2 ;; esac
[ -r "$ENV_FILE" ] || die "$ENV_FILE is missing: see deploy/setup-server.sh"

# One deploy at a time on this server, by hand or from GitHub. /run, unlike
# /run/lock, is root's: nobody else can hold the lock.
exec 9>"$LOCK_FILE"
flock -w 600 9 || die "another deploy has held the lock for 10 minutes"

# Where /healthz answers: HTTP_ADDR from the env file, on this machine.
addr=$(sed -n 's/^HTTP_ADDR=//p' "$ENV_FILE" | tail -n 1)
case $addr in
  '') addr=127.0.0.1:8080 ;;
  :*) addr=127.0.0.1$addr ;;
  0.0.0.0:*) addr=127.0.0.1:${addr#0.0.0.0:} ;;
  '[::]':*) addr="[::1]:${addr#'[::]':}" ;;
esac

# A one-off command with the new image. Without --sig-proxy=false, a Ctrl-C
# or a dropped SSH session would be passed on to it and stop a migration half
# way; this way the migration finishes, and only this script stops.
run() { docker run --rm --sig-proxy=false --network host --env-file "$ENV_FILE" "$IMG" "$@"; }
start() {
  docker run -d --name "$NAME" --restart unless-stopped --stop-timeout 20 \
    --log-opt max-size=20m --log-opt max-file=5 \
    --network host --env-file "$ENV_FILE" -v "$DATA_DIR":/data "$1" >/dev/null
}
# version_of IMAGE: its `version` line, v0.2.0 (abc1234, 2026-09-25T04:10:07Z).
version_of() { docker run --rm "$1" version 2>/dev/null || true; }
commit_of() { printf '%s\n' "$1" | sed -n 's/^[^(]*(\([^,]*\),.*/\1/p'; }
# healthy VERSION COMMIT: whether /healthz reports them within the tries.
healthy() {
  i=0
  until curl -fsS "http://$addr/healthz" 2>/dev/null | grep -q "\"version\":\"$1\",\"commit\":\"$2\""; do
    i=$((i + 1))
    [ "$i" -lt "$HEALTH_TRIES" ] || return 1
    sleep 2
  done
}

docker pull "$IMG" || die "could not pull $IMG (is this server logged in to ghcr.io?)"

backup=$BACKUP_DIR/deploy-$(date -u +%Y%m%d-%H%M%S).dump
# Under another name until it is whole: a dump cut short is not a backup.
runuser -u postgres -- pg_dump -Fc -f "$backup.part" "$NAME" ||
  { rm -f "$backup.part"; die "the database backup failed; nothing was changed"; }
mv "$backup.part" "$backup"
echo "database backed up: $backup"
# Keep the newest deploy backups; the nightly ones (daily-N) are apart.
# shellcheck disable=SC2012 # the names are this script's own: no spaces
ls -1t "$BACKUP_DIR"/deploy-*.dump 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while read -r old; do rm -f -- "$old"; done

run migrate up || die "migrate up failed; the version that was running is still running (docs/deploying.md, A migration failed)"
run seed || die "seed failed; the version that was running is still running"

want=$(version_of "$IMG")
ver=${want%% *}
commit=$(commit_of "$want")
if [ -z "$ver" ] || [ -z "$commit" ]; then die "cannot read the version of $IMG: $want"; fi

prev=$(docker inspect -f '{{.Config.Image}}' "$NAME" 2>/dev/null || true)
prev_id=$(docker inspect -f '{{.Image}}' "$NAME" 2>/dev/null || true)
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ${prev:-none} -> $IMG" >> "$LOG_FILE"
if [ -n "$prev" ]; then
  docker stop "$NAME" >/dev/null
  docker rm "$NAME" >/dev/null
fi
start "$IMG"

if ! healthy "$ver" "$commit"; then
  echo "aishie-deploy: $want did not report healthy within $((HEALTH_TRIES * 2)) seconds. Its last log lines:" >&2
  docker logs --tail 30 "$NAME" >&2 2>&1 || true
  # The schema is one the version before works with (CONTRIBUTING.md,
  # Migrations), so it can take over again: if it is another image, not the
  # same one by another name, and with the env file as it is now.
  if [ -n "$prev" ] && [ "$prev_id" != "$(docker image inspect -f '{{.Id}}' "$IMG" 2>/dev/null || true)" ]; then
    docker rm -f "$NAME" >/dev/null
    start "$prev"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $IMG -> $prev (not healthy: rolled back)" >> "$LOG_FILE"
    back=$(version_of "$prev")
    healthy "${back%% *}" "$(commit_of "$back")" ||
      die "started $prev again, but it did not report healthy either: most likely the env file (docker logs $NAME)"
    die "rolled back: $prev is running again"
  fi
  die "the version before was ${prev:-none}: see docs/deploying.md, The new version did not report healthy"
fi
echo "deployed: $want (before: ${prev:-none})"

# The images of this project that no container uses, the one before included:
# a rollback pulls its image again.
docker image prune -af --filter "label=org.opencontainers.image.source=https://github.com/AIShie-Education/AIShie-Core" >/dev/null 2>&1 || true
